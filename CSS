
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --background: #080710;
  --surface: #11101d;
  --surface-light: #19172a;
  --purple: #9147ff;
  --purple-light: #bd8cff;
  --text: #f7f3ff;
  --muted: #9993ad;
  --border: rgba(174, 117, 255, 0.18);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--background);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  min-height: 100vh;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
  color: white;
  border: none;
}

#intro {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #05040b;
  animation: introFade 2.8s forwards;
}

.intro-logo {
  width: 105px;
  height: 105px;
  display: grid;
  place-items: center;
  font: 800 68px 'Orbitron', sans-serif;
  color: white;
  border: 2px solid var(--purple);
  border-radius: 28px;
  background: linear-gradient(145deg, #38205d, #100b1d);
  box-shadow: 0 0 25px var(--purple), 0 0 75px #742cff;
  animation: logoMove 2s ease-in-out;
}

#intro h1 {
  margin-top: 28px;
  font: 800 38px 'Orbitron', sans-serif;
  letter-spacing: 9px;
  animation: textAppear 1.4s ease;
}

#intro p {
  color: var(--purple-light);
  margin-top: 12px;
  letter-spacing: 5px;
  animation: textAppear 1.8s ease;
}

@keyframes logoMove {
  0% { transform: scale(.5) rotate(-25deg); opacity: 0; }
  55% { transform: scale(1.12) rotate(8deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); }
}

@keyframes textAppear {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes introFade {
  0%, 75% { opacity: 1; visibility: visible; }
  100% { opacity: 0; visibility: hidden; pointer-events: none; }
}

#app {
  min-height: 100vh;
  animation: appAppear .8s ease 2.4s both;
}

@keyframes appAppear {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.topbar {
  height: 88px;
  padding: 0 35px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0d0b17;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 15px;
}

.brand-logo {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  font: 700 27px 'Orbitron', sans-serif;
  background: linear-gradient(135deg, #a45cff, #4813a3);
  box-shadow: 0 0 22px #812eff70;
}

.brand h1 {
  font: 700 19px 'Orbitron', sans-serif;
  letter-spacing: 3px;
}

.brand p {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 2px;
  margin-top: 4px;
}

.status {
  color: #9bffbd;
  font-size: 11px;
  letter-spacing: 1px;
}

.layout {
  display: flex;
  min-height: calc(100vh - 88px);
}

.sidebar {
  width: 245px;
  flex-shrink: 0;
  padding: 35px 20px;
  background: #0d0b17;
  border-right: 1px solid var(--border);
}

.sidebar h3 {
  color: #777087;
  font-size: 10px;
  letter-spacing: 3px;
  margin: 0 0 20px 12px;
}

.nav-btn {
  width: 100%;
  text-align: left;
  padding: 15px;
  margin-bottom: 8px;
  border-radius: 10px;
  background: transparent;
  color: #aaa4bd;
  transition: .2s;
}

.nav-btn:hover,
.nav-btn.active {
  color: white;
  background: linear-gradient(90deg, #7534cf50, #7534cf10);
  box-shadow: inset 3px 0 var(--purple);
}

.content {
  flex: 1;
  padding: 45px;
  max-width: 1500px;
}

.page {
  display: none;
}

.page.active {
  display: block;
  animation: pageIn .35s ease;
}

@keyframes pageIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.content h2 {
  font-size: 29px;
  font-weight: 700;
}

.subtitle {
  color: var(--muted);
  margin-top: 8px;
  margin-bottom: 32px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 30px;
}

.stat-card, .panel {
  background: linear-gradient(145deg, #171426, #100e19);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 12px 35px #00000020;
}

.stat-card p {
  color: var(--muted);
  font-size: 13px;
}

.stat-card h2 {
  color: var(--purple-light);
  font-size: 29px;
  margin-top: 17px;
}

.panel {
  margin-bottom: 25px;
}

.panel h3 {
  font-size: 17px;
  margin-bottom: 20px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.primary-btn {
  padding: 13px 20px;
  border-radius: 9px;
  font-weight: 600;
  background: linear-gradient(110deg, #853cff, #5a20b9);
  box-shadow: 0 5px 20px #843cff30;
  transition: .2s;
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 7px 25px #843cff70;
}

input, select {
  width: 100%;
  display: block;
  margin: 10px 0 17px;
  padding: 14px;
  border-radius: 9px;
  color: white;
  background: #0c0a15;
  border: 1px solid var(--border);
  outline: none;
}

input:focus, select:focus {
  border-color: var(--purple);
  box-shadow: 0 0 0 3px #9147ff20;
}

label {
  color: var(--muted);
  font-size: 13px;
}

.product-row, .sale-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 15px 0;
  border-bottom: 1px solid var(--border);
}

.product-row:last-child, .sale-row:last-child {
  border-bottom: none;
}

.delete-btn {
  padding: 8px 12px;
  border-radius: 7px;
  background: #a82e4b;
}

#saleMessage {
  color: var(--purple-light);
  margin-top: 15px;
}

@media (max-width: 900px) {
  .stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content {
    padding: 25px;
  }
}

@media (max-width: 600px) {
  .topbar {
    padding: 0 15px;
  }

  .status {
    display: none;
  }

  .layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    padding: 15px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .sidebar h3 {
    width: 100%;
  }

  .nav-btn {
    width: auto;
    margin: 0;
  }

  .stats {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .stat-card {
    padding: 17px;
  }

  .stat-card h2 {
    font-size: 22px;
  }

  .content {
    padding: 20px 15px;
  }
}
